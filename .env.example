# ---------------------------------------------------------------------------
# Responder — copy this file to `.env` and fill in the values.
#
# NOTE: Google OAuth credentials, LLM API keys and the organisation description
# are NOT set here. They belong to each organisation and are entered in the app
# (encrypted before they are stored). This file only holds infrastructure.
# ---------------------------------------------------------------------------

# PostgreSQL. For local development:
#   docker run -d --name responder-pg -e POSTGRES_PASSWORD=responder \
#     -e POSTGRES_USER=responder -e POSTGRES_DB=responder -p 5433:5432 postgres:16
DATABASE_URL="postgresql://responder:responder@localhost:5433/responder?schema=public"

# Public base URL of this app. Must match the Google OAuth redirect URI host.
APP_BASE_URL="http://localhost:3000"

# 32+ random chars. Encrypts OAuth tokens, client secrets and LLM API keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Signs the login session cookie. Falls back to ENCRYPTION_KEY when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Shared secret required by the /api/cron/* endpoints. The in-process scheduler
# calls those endpoints, so this must be set for background jobs to run.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Password given to the three seeded accounts on first boot. Change it before
# exposing the app publicly.
SEED_PASSWORD="111"

# The redirect URI registered on each organisation's OAuth client. The app
# serves two callback paths and either may be registered in Google Cloud:
#   /api/auth/google/callback
#   /api/auth/callback/google   (NextAuth-style)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# --- Scheduling ------------------------------------------------------------
ENABLE_CRON="true"
INGEST_CRON="15 3 * * *"
PUBLISH_CRON="*/15 * * * *"
