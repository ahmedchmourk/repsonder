# ---------------------------------------------------------------------------
# Responder — copy this file to `.env` and fill in the values.
#
# NOTE: Google OAuth credentials, LLM API keys, the business context and the
# reply delay are NOT set here. They belong to each business and are entered in
# the app (encrypted before they are stored). This file only holds app-wide
# infrastructure settings.
# ---------------------------------------------------------------------------

# SQLite database file (relative paths are resolved from ./prisma)
DATABASE_URL="file:./responder.db"

# Public base URL of this app. Must match the Google OAuth redirect URI host.
APP_BASE_URL="http://localhost:3000"

# 32+ random chars. Encrypts OAuth tokens, client secrets and LLM API keys at
# rest. Losing or changing it means re-entering every credential.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Shared secret required by the /api/cron/* endpoints. The in-process scheduler
# calls those endpoints, so this must be set for background jobs to run.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Default redirect URI for new businesses. Each business can override it in the
# Settings panel, so this is only a starting value. The app serves two callback
# paths and either may be registered in Google Cloud:
#   /api/auth/google/callback   (default)
#   /api/auth/callback/google   (NextAuth-style)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- Scheduling ------------------------------------------------------------
# Set to "false" to disable the in-process node-cron scheduler (e.g. if you
# drive /api/cron/* from an external scheduler or QStash instead).
ENABLE_CRON="true"
# Cron expression for the 24h ingest+process cycle (default: 03:15 daily).
# Runs for every active, connected business.
INGEST_CRON="15 3 * * *"
# How often the publisher checks for replies whose delay has elapsed.
PUBLISH_CRON="*/15 * * * *"
